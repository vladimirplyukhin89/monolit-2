---
export type ServiceSectionId = 'remont' | 'blagoustrojstvo';

export interface Props {
  readonly currentSection?: ServiceSectionId;
}

interface NextSectionConfig {
  readonly href: string;
  readonly titlePrefix: string;
  readonly titleAccent: string;
  readonly description: string;
}

const { currentSection } = Astro.props;

const pathname = Astro.url.pathname;
const normalizedPath =
  pathname.length > 1 && pathname.endsWith('/')
    ? pathname.slice(0, -1)
    : pathname;

const resolvedSection: ServiceSectionId =
  currentSection ??
  (normalizedPath.startsWith('/blagoustrojstvo') ? 'blagoustrojstvo' : 'remont');

const NEXT_SECTION_MAP: Record<ServiceSectionId, NextSectionConfig> = {
  remont: {
    href: '/blagoustrojstvo',
    titlePrefix: 'Благоустройство ',
    titleAccent: 'участков',
    description:
      'Брусчатка, асфальтирование, отмостки и дренаж от прямых производителей с гарантией до 5 лет.',
  },
  blagoustrojstvo: {
    href: '/remont',
    titlePrefix: 'Ремонт квартир ',
    titleAccent: 'под\u00A0ключ',
    description:
      'Дизайн-проект, инженерные сети, чистовая отделка и авторский надзор по одному договору.',
  },
};

const nextSection = NEXT_SECTION_MAP[resolvedSection];
---

<section
  aria-labelledby="page-navigation-heading"
  class="border-t border-border-subtle bg-bg-primary py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <!-- Редакционный заголовок секции в эстетике Verelle Private -->
    <div class="reveal flex flex-col justify-between gap-4 border-b border-border-subtle pb-8 sm:flex-row sm:items-end lg:pb-10">
      <div>
        <p class="mb-3 cursor-default select-none text-xs uppercase tracking-[0.22em] text-text-muted">
          Навигация · 01 — 02
        </p>
        <h2
          id="page-navigation-heading"
          class="cursor-default text-2xl font-normal leading-[1.14] tracking-tight text-text-primary sm:text-3xl lg:text-4xl"
        >
          Другие{' '}
          <span class="font-serif text-[1.15em] font-medium italic leading-none text-accent md:text-[1.12em] md:leading-[1.15]">
            разделы
          </span>
        </h2>
      </div>

      <p class="max-w-sm cursor-default text-xs leading-relaxed text-text-secondary sm:text-right sm:text-sm">
        Переходите между направлениями компании Монолит или вернитесь на разводящую страницу.
      </p>
    </div>

    <!-- Две кликабельные карточки-ссылки <a> -->
    <nav
      aria-label="Переходы по разделам сайта"
      class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:mt-10 lg:gap-6"
    >
      <!-- Карточка 01: всегда ведёт на разводящую главную страницу / -->
      <div class="reveal h-full">
        <a
          href="/"
          class="group flex h-full cursor-pointer flex-col justify-between border border-border-subtle bg-bg-secondary p-7 transition-colors duration-[350ms] ease-[var(--ease-editorial)] hover:border-border-accent focus-visible:border-border-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent sm:p-8 lg:p-10"
        >
          <div>
            <div class="flex items-center justify-between gap-4">
              <span class="inline-flex items-center gap-2.5 text-[11px] uppercase leading-none tracking-[0.2em] text-text-muted">
                <span class="font-serif text-base italic tracking-normal text-accent">
                  01
                </span>
                <span aria-hidden="true" class="text-text-muted/60">·</span>
                <span>Разводящая страница</span>
              </span>
            </div>

            <h3 class="mt-6 text-2xl font-normal leading-[1.18] tracking-tight text-text-primary sm:text-[1.75rem]">
              Все направления{' '}
              <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
                компании Монолит
              </span>
            </h3>

            <p class="mt-3 max-w-md text-sm leading-relaxed text-text-secondary">
              На главной каждое направление открывается своей карточкой: ремонт квартир отдельно, благоустройство участков отдельно.
            </p>
          </div>

          <div class="mt-8 flex items-center gap-2.5 border-t border-border-subtle pt-5 text-sm font-medium text-text-secondary transition-colors duration-[350ms] ease-[var(--ease-editorial)] group-hover:text-text-primary group-focus-visible:text-text-primary">
            <svg
              class="h-4 w-4 shrink-0 text-accent transition-transform duration-[350ms] ease-[var(--ease-editorial)] group-hover:-translate-x-[4px] group-focus-visible:-translate-x-[4px] motion-reduce:transform-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5" />
              <path d="m11 18-6-6 6-6" />
            </svg>
            <span>На главную</span>
          </div>
        </a>
      </div>

      <!-- Карточка 02: ведёт на соседнюю услугу -->
      <div class="reveal reveal-delay-100 h-full">
        <a
          href={nextSection.href}
          class="group flex h-full cursor-pointer flex-col justify-between border border-border-subtle bg-bg-secondary p-7 transition-colors duration-[350ms] ease-[var(--ease-editorial)] hover:border-border-accent focus-visible:border-border-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent sm:p-8 lg:p-10"
        >
          <div>
            <div class="flex items-center justify-between gap-4">
              <span class="inline-flex items-center gap-2.5 text-[11px] uppercase leading-none tracking-[0.2em] text-text-muted">
                <span class="font-serif text-base italic tracking-normal text-accent">
                  02
                </span>
                <span aria-hidden="true" class="text-text-muted/60">·</span>
                <span>Другое направление</span>
              </span>
            </div>

            <h3 class="mt-6 text-2xl font-normal leading-[1.18] tracking-tight text-text-primary sm:text-[1.75rem]">
              {nextSection.titlePrefix}
              <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
                {nextSection.titleAccent}
              </span>
            </h3>

            <p class="mt-3 max-w-md text-sm leading-relaxed text-text-secondary">
              {nextSection.description}
            </p>
          </div>

          <div class="mt-8 flex items-center gap-2.5 border-t border-border-subtle pt-5 text-sm font-medium text-text-secondary transition-colors duration-[350ms] ease-[var(--ease-editorial)] group-hover:text-text-primary group-focus-visible:text-text-primary">
            <span>Следующий раздел</span>
            <svg
              class="h-4 w-4 shrink-0 text-accent transition-transform duration-[350ms] ease-[var(--ease-editorial)] group-hover:translate-x-[4px] group-focus-visible:translate-x-[4px] motion-reduce:transform-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </div>
        </a>
      </div>
    </nav>
  </div>
</section>
