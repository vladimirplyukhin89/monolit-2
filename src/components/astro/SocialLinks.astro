---
import {
  COMPANY_CONTACTS,
  type SocialLinkItem,
} from '../../data/navigation';

export type SocialLinksVariant = 'default' | 'compact';

export interface Props {
  variant?: SocialLinksVariant;
  phoneHref?: string | null;
  emailHref?: string | null;
  telegramHref?: string | null;
  maxHref?: string | null;
  items?: readonly SocialLinkItem[];
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'default',
  phoneHref = COMPANY_CONTACTS.socialLinks.phoneHref,
  emailHref = COMPANY_CONTACTS.socialLinks.emailHref,
  telegramHref = COMPANY_CONTACTS.socialLinks.telegramHref,
  maxHref = COMPANY_CONTACTS.socialLinks.maxHref ?? null,
  items,
  ariaLabel = 'Социальные сети и быстрая связь',
  class: className = '',
} = Astro.props;

const isCompact = variant === 'compact';

const defaultItems: SocialLinkItem[] = [];

if (phoneHref) {
  defaultItems.push({
    id: 'phone',
    href: phoneHref,
    ariaLabel: 'Позвонить',
    title: COMPANY_CONTACTS.phoneDisplay,
    external: false,
  });
}

if (emailHref) {
  defaultItems.push({
    id: 'email',
    href: emailHref,
    ariaLabel: 'Написать на почту',
    title: COMPANY_CONTACTS.email,
    external: false,
  });
}

if (telegramHref) {
  defaultItems.push({
    id: 'telegram',
    href: telegramHref,
    ariaLabel: 'Telegram',
    title: 'Telegram',
    external: true,
  });
}

if (maxHref) {
  defaultItems.push({
    id: 'max',
    href: maxHref,
    ariaLabel: 'Max',
    title: 'Max',
    external: true,
  });
}

const resolvedItems: readonly SocialLinkItem[] = items ?? defaultItems;

const buttonShell =
  'inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full transition-colors duration-300 ease-[var(--ease-editorial)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary motion-reduce:transition-none';

/* Вариант 1: Тёмный фон иконок (активный) */
const buttonTone =
  'bg-bg-secondary border border-border-subtle text-text-primary hover:bg-accent hover:border-accent hover:text-white';

/*
  Вариант 2: Светлый фон иконок как у первого рефа (можно раскомментировать для сравнения)
  const buttonTone =
    'bg-text-primary text-bg-primary hover:bg-accent hover:text-white';
*/

const buttonClass = `${buttonShell} ${buttonTone}`;
const iconClass = isCompact ? 'h-4 w-4' : 'h-5 w-5';
---

{
  resolvedItems.length > 0 && (
    <div
      class:list={[
        'flex flex-wrap items-center',
        isCompact ? 'gap-2' : 'gap-3',
        className,
      ]}
      role="group"
      aria-label={ariaLabel}
    >
      {/* Вариант 1: Тёмный фон иконок (активный) */}
      {/* Вариант 2: Светлый фон иконок как у первого рефа (можно раскомментировать для сравнения) */}
      {resolvedItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          aria-label={item.ariaLabel}
          title={item.title ?? item.ariaLabel}
          class={buttonClass}
        >
          {item.id === 'phone' && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z" />
            </svg>
          )}

          {item.id === 'email' && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20 4H4a2 2 0 0 0-2 2v.4l10 6.25 10-6.25V6a2 2 0 0 0-2-2Zm2 4.75-9.47 5.92a1 1 0 0 1-1.06 0L2 8.75V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.75Z" />
            </svg>
          )}

          {item.id === 'telegram' && (
            <svg
              class:list={[iconClass, '-translate-x-px']}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20.665 3.717 2.935 10.554c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434Z" />
            </svg>
          )}

          {item.id === 'max' && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12.2 2.5C6.95 2.5 2.7 6.65 2.7 11.85c0 2.02.52 3.92 1.28 5.56.37.8.43 1.66.16 2.52-.24.75.43 1.45 1.2 1.24 1.38-.38 2.58-.36 3.74-.04 1.02.28 2.04.42 3.12.42 5.25 0 9.5-4.18 9.5-9.55 0-5.28-4.25-9.5-9.5-9.5Zm.15 13.85c-1.08 0-2.06-.35-2.85-.94-.32-.24-.75-.16-.96.18-.26.42-.68.78-1.15.96-.15.06-.3-.09-.24-.24.33-.86.44-1.78.22-2.76a4.68 4.68 0 0 1-.12-1.07c0-2.72 2.24-4.93 5.1-4.93 2.86 0 5.05 2.15 5.05 4.88 0 2.7-2.22 4.92-5.05 4.92Z"
              />
            </svg>
          )}
        </a>
      ))}
    </div>
  )
}
