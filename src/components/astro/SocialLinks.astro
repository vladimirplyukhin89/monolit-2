---
import {
  COMPANY_CONTACTS,
  type SocialLinkItem,
} from '../../data/navigation';

export interface Props {
  phoneHref?: string | null;
  emailHref?: string | null;
  telegramHref?: string | null;
  maxHref?: string | null;
  vkHref?: string | null;
  items?: readonly SocialLinkItem[];
  ariaLabel?: string;
  class?: string;
}

const {
  phoneHref = COMPANY_CONTACTS.socialLinks.phoneHref,
  emailHref = COMPANY_CONTACTS.socialLinks.emailHref,
  telegramHref = COMPANY_CONTACTS.socialLinks.telegramHref,
  maxHref = COMPANY_CONTACTS.socialLinks.maxHref ?? null,
  vkHref = COMPANY_CONTACTS.socialLinks.vkHref ?? null,
  items,
  ariaLabel = 'Социальные сети и быстрая связь',
  class: className = '',
} = Astro.props;

const defaultItems: SocialLinkItem[] = [];

if (phoneHref) {
  defaultItems.push({
    id: 'phone',
    href: phoneHref,
    ariaLabel: 'Позвонить',
    title: COMPANY_CONTACTS.phoneDisplay,
    external: false,
  });
}

if (emailHref) {
  defaultItems.push({
    id: 'email',
    href: emailHref,
    ariaLabel: 'Написать на почту',
    title: COMPANY_CONTACTS.email,
    external: false,
  });
}

if (telegramHref) {
  defaultItems.push({
    id: 'telegram',
    href: telegramHref,
    ariaLabel: 'Telegram',
    title: 'Telegram',
    external: true,
  });
}

if (maxHref) {
  defaultItems.push({
    id: 'max',
    href: maxHref,
    ariaLabel: 'Max',
    title: 'Max',
    external: true,
  });
}

if (vkHref) {
  defaultItems.push({
    id: 'vk',
    href: vkHref,
    ariaLabel: 'ВКонтакте',
    title: 'ВКонтакте',
    external: true,
  });
}

const resolvedItems: readonly SocialLinkItem[] = items ?? defaultItems;
---

{
  resolvedItems.length > 0 && (
    <div
      class:list={['flex flex-wrap items-center gap-3', className]}
      role="group"
      aria-label={ariaLabel}
    >
      {resolvedItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          aria-label={item.ariaLabel}
          title={item.title ?? item.ariaLabel}
          class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full bg-text-primary text-bg-primary transition-colors duration-300 ease-[var(--ease-editorial)] hover:bg-accent hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          {item.id === 'phone' && (
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z" />
            </svg>
          )}

          {item.id === 'email' && (
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20 4H4a2 2 0 0 0-2 2v.4l10 6.25 10-6.25V6a2 2 0 0 0-2-2Zm2 4.75-9.47 5.92a1 1 0 0 1-1.06 0L2 8.75V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.75Z" />
            </svg>
          )}

          {item.id === 'telegram' && (
            <svg
              class="h-5 w-5 -translate-x-px"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20.665 3.717 2.935 10.554c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434Z" />
            </svg>
          )}

          {item.id === 'max' && (
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12.2 2.5C6.95 2.5 2.7 6.65 2.7 11.85c0 2.02.52 3.92 1.28 5.56.37.8.43 1.66.16 2.52-.24.75.43 1.45 1.2 1.24 1.38-.38 2.58-.36 3.74-.04 1.02.28 2.04.42 3.12.42 5.25 0 9.5-4.18 9.5-9.55 0-5.28-4.25-9.5-9.5-9.5Zm.15 13.85c-1.08 0-2.06-.35-2.85-.94-.32-.24-.75-.16-.96.18-.26.42-.68.78-1.15.96-.15.06-.3-.09-.24-.24.33-.86.44-1.78.22-2.76a4.68 4.68 0 0 1-.12-1.07c0-2.72 2.24-4.93 5.1-4.93 2.86 0 5.05 2.15 5.05 4.88 0 2.7-2.22 4.92-5.05 4.92Z"
              />
            </svg>
          )}

          {item.id === 'vk' && (
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 2.073-5.336h-3.981c-.772 0-.828.435-1.103 1.083-.995 2.347-2.886 5.387-3.604 4.922-.751-.485-.407-2.406-.35-5.261.015-.754.011-1.271-1.141-1.539-.629-.145-1.241-.205-1.809-.205-2.273 0-3.841.953-2.95 1.119 1.571.293 1.42 3.692 1.054 5.16-.638 2.556-3.036-2.024-4.035-4.305-.241-.548-.315-.974-1.175-.974h-3.255c-.492 0-.787.16-.787.516 0 .602 2.96 6.72 5.786 9.77 2.756 2.975 5.48 2.708 7.376 2.708Z" />
            </svg>
          )}
        </a>
      ))}
    </div>
  )
}
