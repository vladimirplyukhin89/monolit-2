---
import { Image } from 'astro:assets';
import heroBgImage from '../../assets/images/remont/portfolio/design-1.webp';
import { SITE_CONFIG } from '../../data/navigation';
import { HERO_DIRECTION_TAGS, HERO_USP_ITEMS } from '../../data/home';
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border-subtle bg-bg-primary"
>
  <!-- Фоновая фотография с деликатным чистым CSS-зумом (1 -> 1.03 за 1200ms) -->
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden select-none">
    <Image
      src={heroBgImage}
      alt="Интерьер современной гостиной после дизайнерского ремонта под ключ в Тюмени"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-bg-zoom h-full w-full object-cover object-center opacity-65"
    />
    <!-- Семантические редакционные затемнения без хардкодных цветов -->
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-r from-bg-primary via-bg-primary/82 to-bg-primary/35"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-bg-primary via-bg-primary/35 to-bg-primary/65"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-5 pt-12 pb-14 sm:px-8 sm:pt-16 sm:pb-16 lg:px-10 lg:pt-20 lg:pb-18">
    <!-- Редакционный верхний блок: мета-тег, журнальный заголовок, оффер и CTA -->
    <div class="max-w-3xl">
      <p
        data-hero-load
        class="reveal mb-5 inline-flex cursor-default items-center gap-2.5 text-xs uppercase tracking-[0.22em] text-text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span>{SITE_CONFIG.regionMeta} · {SITE_CONFIG.brandSubtitle}</span>
      </p>

      <h1
        data-hero-load
        class="reveal reveal-delay-100 text-4xl font-normal leading-[1.08] tracking-tight text-text-primary sm:text-5xl lg:text-[3.75rem]"
      >
        Один договор. Одна смета.
        <br class="hidden sm:inline" />
        {' '}Одна команда.{' '}
        <span class="font-serif text-[1.12em] font-medium italic whitespace-nowrap text-text-primary">
          Никаких нервов.
        </span>
      </h1>

      <p
        data-hero-load
        class="reveal reveal-delay-200 mt-5 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg"
      >
        Вы занимаетесь своей жизнью. Ремонтом и дизайн-проектом займемся мы.
      </p>

      <!-- Чёткое разделение: кликабельная CTA-кнопка + спокойная некликабельная заметка -->
      <div
        data-hero-load
        class="reveal reveal-delay-300 mt-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7"
      >
        <a
          href="/#quiz"
          data-lead-trigger="hero-cta"
          class="inline-flex cursor-pointer items-center justify-center gap-2.5 rounded-sm bg-accent px-7 py-4 text-sm font-medium text-text-primary transition-colors duration-[350ms] ease-[var(--ease-editorial)] hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <span>Рассчитать смету</span>
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>

        <p class="cursor-default border-l border-border-subtle pl-4 text-xs leading-relaxed text-text-muted">
          Бесплатный выезд инженера на объект
          <span class="block text-text-secondary">и точный расчёт сметы за 24 часа</span>
        </p>
      </div>
    </div>

    <!-- Монолитные теги направлений: без анимаций, параллакса, сдвигов и hover-эффектов -->
    <div
      class="mt-10 border-t border-border-subtle/80 pt-6 lg:mt-12"
      aria-label="Ключевые направления студии"
    >
      <p class="cursor-default text-[11px] uppercase leading-4 tracking-[0.22em] text-text-muted">
        Ключевые направления
      </p>
      <ul class="mt-3 flex flex-wrap items-center gap-2.5">
        {HERO_DIRECTION_TAGS.map((tag) => (
          <li class="inline-flex h-8 cursor-default items-center gap-2 border border-border-subtle bg-bg-secondary/85 px-3.5 text-xs font-normal leading-none tracking-wide text-text-secondary whitespace-nowrap select-none">
            <span
              class="font-serif text-[13px] italic leading-none text-text-muted"
              aria-hidden="true"
            >
              {tag.number}
            </span>
            <span class="leading-none">{tag.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- 4 ключевых УТП: статичные карточки без hover, каскадное появление при загрузке (transition-delay) -->
    <ul
      aria-label="Ключевые преимущества работы с нами"
      class="mt-8 grid grid-cols-1 gap-px border border-border-subtle bg-border-subtle sm:grid-cols-2 lg:mt-10 lg:grid-cols-4"
    >
      {HERO_USP_ITEMS.map((usp) => (
        <li class="cursor-default bg-bg-secondary/92 p-6 backdrop-blur-sm lg:p-7">
          <div
            data-hero-load
            class={`reveal ${usp.delayClass} flex h-full flex-col justify-between gap-4`}
          >
            <div class="flex items-center justify-between gap-3">
              <span
                class="font-serif text-base italic leading-none text-text-muted"
                aria-hidden="true"
              >
                {usp.number}
              </span>
              <span class="h-px flex-1 bg-border-subtle" aria-hidden="true"></span>
            </div>

            <div>
              <h2 class="text-base font-medium leading-snug text-text-primary">
                {usp.title}
              </h2>
              <p class="mt-2.5 text-xs leading-relaxed text-text-secondary sm:text-sm">
                {usp.description}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  function initHeroCascade(): void {
    const heroTargets = Array.from(
      document.querySelectorAll<HTMLElement>('#hero [data-hero-load]'),
    );

    if (heroTargets.length === 0) {
      return;
    }

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    if (prefersReducedMotion) {
      heroTargets.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        heroTargets.forEach((el) => el.classList.add('is-visible'));
      });
    });
  }

  initHeroCascade();
  document.addEventListener('astro:page-load', initHeroCascade);
</script>
