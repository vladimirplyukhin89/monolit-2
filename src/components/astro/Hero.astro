---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import { getFirstImageInDir, getImageAsset } from '../../utils/images';

export interface Props {
  meta: string;
  titlePrefix: string;
  titleAccent: string;
  titleSuffix?: string;
  subtitle: string;
  tags: readonly string[];
  ctaText: string;
  imagePath: string;
  imageAlt: string;
  modalSource?: string;
  breadcrumbCurrent?: string;
}

const {
  meta,
  titlePrefix,
  titleAccent,
  titleSuffix,
  subtitle,
  tags,
  ctaText,
  imagePath,
  imageAlt,
  modalSource = 'hero-cta',
  breadcrumbCurrent,
} = Astro.props;

const heroImage =
  getImageAsset(imagePath, { useFallback: false }) ??
  getFirstImageInDir(imagePath, { useFallback: true });

const showBreadcrumbs =
  Boolean(breadcrumbCurrent) && Astro.url.pathname !== '/';
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border-subtle bg-bg-primary"
>
  <!-- Фоновое изображение с деликатным чистым CSS-зумом (scale 1 -> 1.03 за 1200ms) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 overflow-hidden select-none"
  >
    {
      heroImage ? (
        <Image
          src={heroImage}
          alt={imageAlt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-bg-zoom h-full w-full object-cover object-center opacity-55"
        />
      ) : (
        <div class="h-full w-full bg-gradient-to-br from-bg-elevated via-bg-secondary to-bg-primary" />
      )
    }

    <!-- Мягкие редакционные затемнения для идеальной читаемости текста -->
    <div class="absolute inset-0 bg-gradient-to-r from-bg-primary via-bg-primary/85 to-bg-primary/40" />
    <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-bg-primary/35 to-bg-primary/70" />
  </div>

  <div
    class:list={[
      'relative z-10 mx-auto flex min-h-[540px] max-w-7xl flex-col justify-between px-5 pb-12 sm:min-h-[600px] sm:px-8 sm:pb-14 lg:min-h-[660px] lg:px-10 lg:pb-16',
      showBreadcrumbs
        ? 'pt-10 sm:pt-14 lg:pt-16'
        : 'pt-14 sm:pt-20 lg:pt-24',
    ]}
  >
    <!-- Редакционный верхний блок: хлебные крошки, мета-тег, журнальный заголовок, подзаголовок и CTA -->
    <div class="max-w-3xl">
      {
        showBreadcrumbs && breadcrumbCurrent && (
          <Breadcrumbs
            currentLabel={breadcrumbCurrent}
            class="animate-fade-in-up mb-5"
          />
        )
      }

      <p class="animate-fade-in-up mb-6 inline-flex cursor-default select-none items-center gap-2.5 text-xs uppercase tracking-[0.22em] text-text-muted">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        <span>{meta}</span>
      </p>

      <h1 class="animate-fade-in-up [animation-delay:120ms] max-w-full cursor-default overflow-visible text-balance font-sans text-[1.875rem] font-medium leading-[1.24] tracking-tight text-text-primary min-[400px]:text-4xl min-[400px]:leading-[1.2] sm:text-5xl sm:leading-[1.14] lg:text-[3.75rem] lg:leading-[1.1]">
        {titlePrefix}{' '}
        <span class="font-serif text-[1.08em] italic leading-[1.2] text-accent [padding-inline:0.04em]">{titleAccent}</span>
        {
          titleSuffix && (
            <>
              {' '}
              {titleSuffix}
            </>
          )
        }
      </h1>

      <p class="animate-fade-in-up [animation-delay:240ms] mt-6 max-w-2xl cursor-default text-base leading-relaxed text-text-secondary sm:text-lg">
        {subtitle}
      </p>

      <!-- Чёткое разделение: единственная кликабельная CTA-кнопка + спокойная некликабельная заметка -->
      <div class="animate-fade-in-up [animation-delay:360ms] mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7">
        <button
          type="button"
          data-open-modal={modalSource}
          class="inline-flex cursor-pointer items-center justify-center gap-2.5 rounded-sm bg-accent px-7 py-4 text-sm font-medium text-text-primary transition-colors duration-[350ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <span>{ctaText}</span>
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </button>

        <p class="cursor-default select-none border-l border-border-subtle pl-4 text-xs leading-relaxed text-text-secondary sm:max-w-[260px]">
          Бесплатный выезд специалиста и&nbsp;точный расчёт сметы
        </p>
      </div>
    </div>

    <!-- Строго статичные теги направлений: без анимаций, сдвигов, параллакса и hover-эффектов -->
    {
      tags.length > 0 && (
        <div
          class="mt-12 overflow-x-clip border-t border-border-subtle/80 pt-6 lg:mt-16"
          aria-label="Ключевые направления"
        >
          <p class="cursor-default select-none text-[11px] uppercase leading-4 tracking-[0.22em] text-text-muted">
            Ключевые направления
          </p>
          <ul class="mt-3 flex flex-wrap content-start items-start gap-x-2.5 gap-y-2 overflow-x-clip [contain:layout]">
            {tags.map((tag, index) => (
              <li class="inline-flex h-8 max-w-full shrink-0 cursor-default select-none items-center gap-2 whitespace-nowrap border border-border-subtle bg-bg-secondary/85 px-3.5 text-xs font-normal leading-8 tracking-wide text-text-secondary">
                <span
                  class="font-serif text-[13px] italic leading-8 text-text-muted"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="leading-8">{tag}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
