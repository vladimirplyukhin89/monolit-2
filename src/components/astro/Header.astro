---
import { MAIN_NAV_ITEMS, SITE_CONFIG, SOCIAL_LINKS } from '../../data/navigation';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full border-b border-border-subtle bg-bg-primary/90 backdrop-blur-md"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8 lg:px-10">
    <!-- Логотип -->
    <a
      href={currentPath === '/' ? '#hero' : '/'}
      class="group inline-flex shrink-0 items-center gap-3 rounded-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
      aria-label={`${SITE_CONFIG.brandName} — на главную`}
    >
      <span
        class="flex h-9 w-9 items-center justify-center border border-border-subtle bg-bg-secondary font-serif text-lg italic leading-none text-text-primary transition-colors duration-300 group-hover:border-border-accent group-hover:text-accent"
        aria-hidden="true"
      >
        М
      </span>
      <span class="flex flex-col">
        <span class="text-sm font-semibold tracking-[0.22em] text-text-primary transition-colors duration-300 group-hover:text-accent">
          {SITE_CONFIG.brandName}
        </span>
        <span class="text-[11px] font-normal tracking-wide text-text-muted">
          {SITE_CONFIG.brandSubtitle}
        </span>
      </span>
    </a>

    <!-- Классическая горизонтальная навигация (строго десктоп lg и выше) -->
    <nav
      aria-label="Основная навигация"
      class="hidden lg:flex lg:items-center lg:gap-6 xl:gap-8"
    >
      {MAIN_NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap py-2 text-sm font-normal text-text-secondary transition-colors duration-300 hover:text-text-primary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Правая группа (десктоп lg и выше): мессенджеры + кнопка связи -->
    <div class="hidden shrink-0 lg:flex lg:items-center lg:gap-4">
      <div class="flex items-center gap-2" aria-label="Мессенджеры и соцсети">
        {SOCIAL_LINKS.slice(0, 2).map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-subtle bg-bg-secondary text-text-secondary transition-colors duration-300 hover:border-border-accent hover:text-text-primary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
          >
            {social.id === 'telegram' && (
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21.5 4.5 2.5 11.8l6.8 2.4 2.4 6.3 3.4-3.7 4.9 3.2L21.5 4.5Z" />
                <path d="M9.3 14.2 17.5 8" />
              </svg>
            )}
            {social.id === 'whatsapp' && (
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.5 11.7a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.3-4.4a8.5 8.5 0 1 1 15.7-4.4Z" />
                <path d="M9.2 9.4c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2.1.5-.1.7l-.5.6c-.1.1-.1.3 0 .5.4.8 1.2 1.5 2 1.9.2.1.4.1.5 0l.6-.6c.2-.2.5-.2.7-.1l1.7.8c.3.1.4.3.4.5v.5c0 .4-.2.8-.6 1-1 .4-2.5.3-4.2-.6-1.8-.9-3.1-2.3-3.9-4-.6-1.2-.6-2.1-.1-2.8Z" />
              </svg>
            )}
          </a>
        ))}
      </div>

      <a
        href="/#contact-form"
        data-lead-trigger="header-cta"
        class="inline-flex items-center justify-center whitespace-nowrap rounded-sm bg-accent px-5 py-2.5 text-sm font-medium text-text-primary transition-colors duration-300 hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
      >
        Связаться
      </a>
    </div>

    <!-- Кнопка мобильного меню (строго экраны меньше lg) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
      aria-label="Открыть меню навигации"
      class="inline-flex h-10 w-10 cursor-pointer items-center justify-center border border-border-subtle bg-bg-secondary text-text-primary transition-colors duration-300 hover:border-border-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent lg:hidden"
    >
      <span class="sr-only">Меню</span>
      <svg
        data-icon-open
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="14" y2="17" />
      </svg>
      <svg
        data-icon-close
        class="hidden h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
  </div>

  <!-- Мобильная шторка навигации (строго меньше lg, скрыта на десктопе) -->
  <div
    id="mobile-menu-panel"
    aria-hidden="true"
    class="hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-border-subtle bg-bg-primary lg:hidden"
  >
    <div class="animate-fade-in mx-auto max-w-7xl px-5 py-8 sm:px-8">
      <p class="mb-6 text-xs uppercase tracking-[0.2em] text-text-muted">
        {SITE_CONFIG.regionMeta}
      </p>

      <nav aria-label="Мобильная навигация" class="divide-y divide-border-subtle border-y border-border-subtle">
        {MAIN_NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            data-mobile-nav-link
            class="flex items-baseline justify-between py-4 text-base font-normal text-text-primary transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
          >
            <span>{item.label}</span>
            <span class="font-serif text-sm italic text-text-muted">{item.number}</span>
          </a>
        ))}
      </nav>

      <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-2">
          <a
            href={SITE_CONFIG.phoneHref}
            class="text-base font-medium text-text-primary transition-colors duration-300 hover:text-accent"
          >
            {SITE_CONFIG.phoneDisplay}
          </a>
          <div class="flex items-center gap-3 pt-1">
            {SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-subtle bg-bg-secondary text-text-secondary transition-colors duration-300 hover:border-border-accent hover:text-text-primary"
              >
                {social.id === 'telegram' && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.5 4.5 2.5 11.8l6.8 2.4 2.4 6.3 3.4-3.7 4.9 3.2L21.5 4.5Z" />
                    <path d="M9.3 14.2 17.5 8" />
                  </svg>
                )}
                {social.id === 'whatsapp' && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.5 11.7a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.3-4.4a8.5 8.5 0 1 1 15.7-4.4Z" />
                    <path d="M9.2 9.4c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2.1.5-.1.7l-.5.6c-.1.1-.1.3 0 .5.4.8 1.2 1.5 2 1.9.2.1.4.1.5 0l.6-.6c.2-.2.5-.2.7-.1l1.7.8c.3.1.4.3.4.5v.5c0 .4-.2.8-.6 1-1 .4-2.5.3-4.2-.6-1.8-.9-3.1-2.3-3.9-4-.6-1.2-.6-2.1-.1-2.8Z" />
                  </svg>
                )}
                {social.id === 'vk' && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 7.5c.2 5.4 3.4 9 8.7 9h.5v-3.2c1.8.2 3.1 1.5 3.7 3.2H19c-.8-2.6-2.8-4.1-4.1-4.6 1.3-.7 3.1-2.4 3.5-4.4h-2.8c-.6 1.8-2.1 3.5-3.4 3.7V7.5H9.6v6.5c-1.4-.3-3.1-2-3.2-6.5H3Z" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>

        <a
          href="/#contact-form"
          data-mobile-nav-link
          data-lead-trigger="mobile-cta"
          class="inline-flex items-center justify-center rounded-sm bg-accent px-6 py-3 text-sm font-medium text-text-primary transition-colors duration-300 hover:bg-accent-hover"
        >
          Обсудить проект
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function initHeaderMenu(): void {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-menu-panel');

    if (!(toggleBtn instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
      return;
    }

    if (toggleBtn.dataset.bound === 'true') {
      return;
    }
    toggleBtn.dataset.bound = 'true';

    const openIcon = toggleBtn.querySelector<SVGElement>('[data-icon-open]');
    const closeIcon = toggleBtn.querySelector<SVGElement>('[data-icon-close]');
    const navLinks = panel.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]');
    const desktopMq = window.matchMedia('(min-width: 1024px)');

    const setMenuOpen = (isOpen: boolean): void => {
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      toggleBtn.setAttribute(
        'aria-label',
        isOpen ? 'Закрыть меню навигации' : 'Открыть меню навигации',
      );
      panel.setAttribute('aria-hidden', String(!isOpen));
      panel.classList.toggle('hidden', !isOpen);
      openIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);
      document.body.classList.toggle('overflow-hidden', isOpen);
    };

    toggleBtn.addEventListener('click', () => {
      const currentlyOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!currentlyOpen);
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggleBtn.focus();
      }
    });

    desktopMq.addEventListener('change', (event: MediaQueryListEvent) => {
      if (event.matches) {
        setMenuOpen(false);
      }
    });
  }

  initHeaderMenu();
  document.addEventListener('astro:page-load', initHeaderMenu);
</script>
