---
import BrandLogo from './BrandLogo.astro';
import SocialLinks from './SocialLinks.astro';
import {
  COMPANY_CONTACTS,
  DIRECTION_PAGES,
  HUB_CONFIG,
  MAIN_NAV_ITEMS,
  SITE_CONFIG,
  type PageSwitchId,
} from '../../data/navigation';
import {
  LANDSCAPING_CONTACTS,
  LANDSCAPING_NAV_ITEMS,
} from '../../data/landscaping';

export interface Props {
  currentPath?: string;
  compact?: boolean;
}

const { currentPath = Astro.url.pathname, compact = false } = Astro.props;

const normalizedPath =
  currentPath.length > 1 && currentPath.endsWith('/')
    ? currentPath.slice(0, -1)
    : currentPath;

const isLandscaping = normalizedPath.startsWith('/blagoustrojstvo');
const isRepair = normalizedPath.startsWith('/remont');
const isHub = normalizedPath === '/' || normalizedPath === '';
const activePageId: PageSwitchId | null = isLandscaping
  ? 'landscaping'
  : isRepair
    ? 'repair'
    : isHub
      ? 'hub'
      : null;

const navItems = isLandscaping ? LANDSCAPING_NAV_ITEMS : MAIN_NAV_ITEMS;
const brandSubtitle = isLandscaping
  ? LANDSCAPING_CONTACTS.brandSubtitle
  : SITE_CONFIG.brandSubtitle;
const regionMeta = isLandscaping
  ? LANDSCAPING_CONTACTS.regionMeta
  : SITE_CONFIG.regionMeta;
const phoneDisplay = COMPANY_CONTACTS.phoneDisplay;
const phoneHref = COMPANY_CONTACTS.phoneHref;
const email = COMPANY_CONTACTS.email;
const emailHref = COMPANY_CONTACTS.emailHref;
const ctaTrigger = isLandscaping ? 'landscaping-header-cta' : 'header-cta';
const mobileCtaTrigger = isLandscaping ? 'landscaping-header-cta' : 'mobile-cta';
const ctaHref = isLandscaping ? '#contact-form' : '/remont#contact-form';
---

{
  compact ? (
    <header
      id="site-header"
      class="sticky top-0 z-40 w-full overflow-x-clip border-b border-border-subtle bg-bg-primary/92 backdrop-blur-md"
    >
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:h-[72px] sm:gap-3 sm:px-8 lg:px-10">
        <!-- Левая группа: логотип + подпись региона -->
        <div class="flex min-w-0 items-center gap-3 sm:gap-4">
          <a
            href="/"
            aria-current={isHub ? 'page' : undefined}
            aria-label={`${SITE_CONFIG.brandName} — главная страница`}
            class="group inline-flex shrink-0 items-center rounded-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
          >
            <BrandLogo size="lg" />
          </a>

          <span
            aria-hidden="true"
            class="hidden h-4 w-px shrink-0 bg-border-subtle sm:inline-block"
          />

          <p class="hidden cursor-default truncate text-xs uppercase tracking-[0.18em] text-text-muted sm:block">
            {HUB_CONFIG.subtitle}
          </p>
        </div>

        <!-- Правая группа: телефон, мессенджеры и кнопка «Связаться» (открывает LeadModal) -->
        <div class="flex shrink-0 items-center gap-2.5 sm:gap-4">
          <a
            href={HUB_CONFIG.phoneHref}
            class="hidden whitespace-nowrap text-sm font-medium tracking-tight text-text-primary transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent md:inline-flex"
          >
            {HUB_CONFIG.phoneDisplay}
          </a>

          <div class="hidden lg:block">
            <SocialLinks
              variant="compact"
              ariaLabel="Быстрая связь и мессенджеры"
            />
          </div>

          <button
            type="button"
            data-lead-trigger="hub-header-cta"
            class="inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center whitespace-nowrap rounded-sm bg-accent px-3 py-2.5 text-xs font-semibold text-white transition-colors duration-300 hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary sm:px-5 sm:text-sm"
          >
            Связаться
          </button>

          <!-- Кнопка мобильного меню (строго экраны меньше lg) -->
          <button
            id="mobile-menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
            aria-label="Открыть меню навигации"
            class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center border border-border-subtle bg-bg-secondary text-text-primary transition-colors duration-300 hover:border-border-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent lg:hidden!"
          >
            <span class="sr-only">Меню</span>
            <svg
              data-icon-open
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="14" y2="17" />
            </svg>
            <svg
              data-icon-close
              class="hidden h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="5" y1="5" x2="19" y2="19" />
              <line x1="19" y1="5" x2="5" y2="19" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Мобильная шторка навигации для разводящей страницы (строго меньше lg) -->
      <div
        id="mobile-menu-panel"
        aria-hidden="true"
        inert
        class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-border-subtle bg-bg-primary sm:max-h-[calc(100dvh-72px)] lg:hidden!"
      >
        <div class="animate-fade-in mx-auto max-w-7xl px-5 py-8 sm:px-8">
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-text-muted">
            {HUB_CONFIG.subtitle}
          </p>

          <nav
            aria-label="Направления компании"
            class="divide-y divide-border-subtle border-y border-border-subtle"
          >
            {DIRECTION_PAGES.map((page, index) => {
              const isActive = page.id === activePageId;
              return (
                <a
                  href={page.href}
                  data-mobile-nav-link
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'flex items-baseline justify-between py-4 text-base font-normal transition-colors duration-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent',
                    isActive
                      ? 'text-accent'
                      : 'text-text-primary hover:text-accent',
                  ]}
                >
                  <span>{page.label}</span>
                  <span class="font-serif text-sm italic text-accent">
                    {`0${index + 1}`}
                  </span>
                </a>
              );
            })}
          </nav>

          <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex flex-col gap-2">
              <a
                href={phoneHref}
                class="text-base font-medium text-text-primary transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
              >
                {phoneDisplay}
              </a>

              <a
                href={emailHref}
                class="text-sm text-text-secondary transition-colors duration-300 hover:text-text-primary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
              >
                {email}
              </a>

              <address class="not-italic text-xs text-text-muted">
                {HUB_CONFIG.address}
              </address>

              <SocialLinks
                variant="compact"
                class="pt-2"
                ariaLabel="Быстрая связь и мессенджеры"
              />
            </div>

            <button
              type="button"
              data-mobile-nav-link
              data-lead-trigger="hub-header-cta"
              class="inline-flex cursor-pointer items-center justify-center rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-white transition-colors duration-300 hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
            >
              Обсудить проект
            </button>
          </div>
        </div>
      </div>
    </header>
  ) : (
    <header
      id="site-header"
      class="sticky top-0 z-40 w-full overflow-x-clip border-b border-border-subtle bg-bg-primary/90 backdrop-blur-md"
    >
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:h-20 sm:gap-3 sm:px-8 lg:gap-3 lg:px-6">
        <!-- Левая группа: логотип (ссылка на главную /) + переключатель страниц (десктоп lg и выше) -->
        <div class="flex min-w-0 shrink-0 items-center gap-3">
          <a
            href="/"
            class="group inline-flex shrink-0 items-center rounded-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
            aria-label={`${SITE_CONFIG.brandName} — на главную`}
          >
            <BrandLogo size="lg" subtitle={brandSubtitle} />
          </a>

          <!-- Переключатель разделов: Главная / Ремонт квартир / Благоустройство (десктоп) -->
          <nav
            aria-label="Направления компании"
            class="hidden items-center rounded-sm border border-border-subtle bg-bg-secondary p-0.5 lg:inline-flex"
          >
            {DIRECTION_PAGES.map((page) => {
              const isActive = page.id === activePageId;
              return (
                <a
                  href={page.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'whitespace-nowrap rounded-xs px-2.5 py-1.5 text-xs font-medium leading-none transition-colors duration-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent',
                    isActive
                      ? 'border border-border-accent bg-accent-muted text-accent'
                      : 'border border-transparent text-text-secondary hover:text-text-primary',
                  ]}
                >
                  {page.shortLabel}
                </a>
              );
            })}
          </nav>
        </div>

        <!-- Классическая горизонтальная навигация по секциям (строго десктоп lg и выше) -->
        <nav
          aria-label="Основная навигация"
          class="hidden lg:flex lg:items-center lg:gap-3"
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              class="whitespace-nowrap py-2 text-[13px] font-normal text-text-secondary transition-colors duration-300 hover:text-text-primary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Правая группа (десктоп lg и выше): мессенджеры + кнопка связи -->
        <div class="hidden shrink-0 lg:flex lg:items-center lg:gap-2">
          <div class="hidden xl:block">
            <SocialLinks
              variant="compact"
              ariaLabel="Быстрая связь и мессенджеры"
            />
          </div>

          <a
            href={ctaHref}
            data-lead-trigger={ctaTrigger}
            class="inline-flex items-center justify-center whitespace-nowrap rounded-sm bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-colors duration-300 hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
          >
            Связаться
          </a>
        </div>

        <!-- Кнопка мобильного меню (строго экраны меньше lg) -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label="Открыть меню навигации"
          class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center border border-border-subtle bg-bg-secondary text-text-primary transition-colors duration-300 hover:border-border-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent lg:hidden!"
        >
          <span class="sr-only">Меню</span>
          <svg
            data-icon-open
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="14" y2="17" />
          </svg>
          <svg
            data-icon-close
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="5" y1="5" x2="19" y2="19" />
            <line x1="19" y1="5" x2="5" y2="19" />
          </svg>
        </button>
      </div>

      <!-- Мобильная шторка навигации (строго меньше lg, скрыта на десктопе) -->
      <div
        id="mobile-menu-panel"
        aria-hidden="true"
        inert
        class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-border-subtle bg-bg-primary sm:max-h-[calc(100dvh-5rem)] lg:hidden!"
      >
        <div class="animate-fade-in mx-auto max-w-7xl px-5 py-8 sm:px-8">
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-text-muted">
            {regionMeta}
          </p>

          <!-- Переключатель разделов в мобильном меню -->
          <div
            role="navigation"
            aria-label="Переключение направлений"
            class="mb-6 grid grid-cols-1 gap-2 sm:grid-cols-3"
          >
            {DIRECTION_PAGES.map((page) => {
              const isActive = page.id === activePageId;
              return (
                <a
                  href={page.href}
                  data-mobile-nav-link
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center justify-center rounded-sm border px-3 py-3 text-center text-xs font-medium transition-colors duration-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent sm:text-sm',
                    isActive
                      ? 'border-border-accent bg-accent-muted text-accent'
                      : 'border-border-subtle bg-bg-secondary text-text-secondary hover:border-border-accent hover:text-text-primary',
                  ]}
                >
                  {page.label}
                </a>
              );
            })}
          </div>

          <nav
            aria-label="Мобильная навигация"
            class="divide-y divide-border-subtle border-y border-border-subtle"
          >
            {navItems.map((item) => (
              <a
                href={item.href}
                data-mobile-nav-link
                class="flex items-baseline justify-between py-4 text-base font-normal text-text-primary transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
              >
                <span>{item.label}</span>
                <span class="font-serif text-sm italic text-accent">
                  {item.number}
                </span>
              </a>
            ))}
          </nav>

          <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col gap-2">
              <a
                href={phoneHref}
                class="text-base font-medium text-text-primary transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
              >
                {phoneDisplay}
              </a>

              <a
                href={emailHref}
                class="text-sm text-text-secondary transition-colors duration-300 hover:text-text-primary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
              >
                {email}
              </a>

              <SocialLinks
                variant="compact"
                class="pt-2"
                ariaLabel="Быстрая связь и мессенджеры"
              />
            </div>

            <a
              href={ctaHref}
              data-mobile-nav-link
              data-lead-trigger={mobileCtaTrigger}
              class="inline-flex items-center justify-center rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-white transition-colors duration-300 hover:bg-accent-hover"
            >
              Обсудить проект
            </a>
          </div>
        </div>
      </div>
    </header>
  )
}

<script>
  function initHeaderMenu(): void {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-menu-panel');

    if (!(toggleBtn instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
      return;
    }

    if (toggleBtn.dataset.bound === 'true') {
      return;
    }
    toggleBtn.dataset.bound = 'true';

    const openIcon = toggleBtn.querySelector<SVGElement>('[data-icon-open]');
    const closeIcon = toggleBtn.querySelector<SVGElement>('[data-icon-close]');
    const navLinks = panel.querySelectorAll<HTMLElement>('[data-mobile-nav-link]');
    const desktopMq = window.matchMedia('(min-width: 1024px)');

    const setMenuOpen = (isOpen: boolean): void => {
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      toggleBtn.setAttribute(
        'aria-label',
        isOpen ? 'Закрыть меню навигации' : 'Открыть меню навигации',
      );
      panel.setAttribute('aria-hidden', String(!isOpen));
      panel.classList.toggle('hidden', !isOpen);
      if (isOpen) {
        panel.removeAttribute('inert');
      } else {
        panel.setAttribute('inert', '');
      }
      openIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);
      document.documentElement.classList.toggle('menu-open', isOpen);
    };

    toggleBtn.addEventListener('click', () => {
      const currentlyOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!currentlyOpen);
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    document.addEventListener('click', (event: MouseEvent) => {
      if (toggleBtn.getAttribute('aria-expanded') !== 'true') {
        return;
      }

      const target = event.target;
      if (!(target instanceof Node)) {
        return;
      }

      if (toggleBtn.contains(target) || panel.contains(target)) {
        return;
      }

      setMenuOpen(false);
    });

    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggleBtn.focus();
      }
    });

    desktopMq.addEventListener('change', (event: MediaQueryListEvent) => {
      if (event.matches) {
        setMenuOpen(false);
      }
    });
  }

  initHeaderMenu();
  document.addEventListener('astro:page-load', initHeaderMenu);
</script>
