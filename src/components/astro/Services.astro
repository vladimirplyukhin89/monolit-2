---
import { SERVICE_ITEMS, SERVICES_OFFER } from '../../data/home';
---

<section
  id="services"
  class="border-b border-border-subtle bg-bg-primary py-20 sm:py-28 lg:py-32"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <!-- Редакционный заголовок секции в стиле Verelle Private -->
    <div class="flex flex-col justify-between gap-6 border-b border-border-subtle pb-10 lg:flex-row lg:items-end lg:pb-12">
      <div class="reveal max-w-2xl">
        <p class="mb-4 text-xs uppercase tracking-[0.22em] text-text-muted">
          Цены и услуги · 01 — 06
        </p>
        <h2 class="text-3xl font-normal leading-[1.12] tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
          Полный цикл работ — от&nbsp;идеи{' '}
          <span class="font-serif text-[1.15em] font-medium italic leading-none text-accent md:text-[1.12em] md:leading-[1.15]">
            до&nbsp;передачи ключей
          </span>
        </h2>
      </div>

      <p class="reveal reveal-delay-100 max-w-md text-sm leading-relaxed text-text-secondary sm:text-base">
        Берём на себя проектирование, инженерию, закупки и чистовую отделку. Вы работаете с одной
        командой и всегда видите прозрачный бюджет и статус объекта.
      </p>
    </div>

    <!-- Статичная сетка направлений/услуг: без hover-подсветки и имитации кликабельности -->
    <div class="mt-12 grid grid-cols-1 gap-px border border-border-subtle bg-border-subtle md:grid-cols-2 lg:mt-14 lg:grid-cols-3">
      {SERVICE_ITEMS.map((service, index) => {
        const delayClass =
          index % 3 === 1
            ? 'reveal-delay-100'
            : index % 3 === 2
              ? 'reveal-delay-200'
              : '';

        return (
          <article class="flex h-full cursor-default flex-col justify-between bg-bg-secondary p-7 sm:p-8">
            <div class={`reveal ${delayClass} flex h-full flex-col justify-between`}>
              <div>
                <div class="flex items-center justify-between gap-4">
                  <span class="font-serif text-lg italic leading-none text-accent">
                    {service.number}
                  </span>

                  {service.isFeatured ? (
                    <span class="inline-flex cursor-default items-center bg-accent-muted px-2.5 py-1 text-[11px] font-medium uppercase leading-none tracking-[0.16em] text-accent select-none">
                      {service.category}
                    </span>
                  ) : (
                    <span class="cursor-default text-[11px] uppercase leading-none tracking-[0.18em] text-text-muted select-none">
                      {service.category}
                    </span>
                  )}
                </div>

                <h3 class="mt-6 text-xl font-normal leading-snug tracking-tight text-text-primary">
                  {service.title}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                  {service.description}
                </p>

                <ul class="mt-6 space-y-2.5 border-t border-border-subtle pt-5">
                  {service.deliverables.map((point) => (
                    <li class="flex items-start gap-2.5 text-xs leading-relaxed text-text-secondary">
                      <span
                        class="mt-[0.45em] h-1 w-1 shrink-0 bg-accent"
                        aria-hidden="true"
                      ></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 flex items-baseline justify-between gap-4 border-t border-border-subtle pt-5">
                <span class="text-sm font-medium text-accent">
                  {service.priceLabel}
                </span>
                <span class="text-xs text-text-muted">
                  {service.timelineLabel}
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Спокойная акцентная плашка с оффером: сама плашка статична, кликабельна только кнопка (hover 350ms) -->
    <aside
      aria-labelledby="services-offer-title"
      class="reveal mt-12 cursor-default border border-border-accent bg-bg-elevated p-7 sm:p-10 lg:mt-16 lg:p-12"
    >
      <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-center lg:gap-12">
        <div class="max-w-2xl">
          <span class="inline-flex cursor-default items-center bg-accent-muted px-3 py-1.5 text-[11px] font-medium uppercase leading-none tracking-[0.18em] text-accent select-none">
            {SERVICES_OFFER.badge}
          </span>

          <h3
            id="services-offer-title"
            class="mt-5 text-2xl font-normal leading-[1.18] tracking-tight text-text-primary sm:text-3xl"
          >
            {SERVICES_OFFER.titlePrefix}
            <span class="font-serif text-[1.15em] font-medium italic leading-none text-accent md:text-[1.12em] md:leading-[1.15]">
              {SERVICES_OFFER.titleAccent}
            </span>
          </h3>

          <p class="mt-3.5 text-sm leading-relaxed text-text-secondary sm:text-base">
            {SERVICES_OFFER.description}
          </p>

          <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-xs text-text-muted">
            {SERVICES_OFFER.highlights.map((item) => (
              <li class="inline-flex cursor-default items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-accent" aria-hidden="true"></span>
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex shrink-0 flex-col items-start gap-3 lg:items-end">
          <a
            href={SERVICES_OFFER.ctaHref}
            data-lead-trigger="services-offer"
            class="inline-flex cursor-pointer items-center justify-center gap-2.5 rounded-sm bg-accent px-7 py-4 text-sm font-semibold text-white transition-colors duration-[350ms] ease-[var(--ease-editorial)] hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >
            <span>{SERVICES_OFFER.ctaLabel}</span>
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </a>
          <p class="cursor-default text-xs text-text-muted">
            {SERVICES_OFFER.note}
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>
