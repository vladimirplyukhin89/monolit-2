---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/astro/Hero.astro';
import SafeImage from '../components/astro/SafeImage.astro';
import PageNavigation from '../components/astro/PageNavigation.astro';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import TabbedGallery, { type GalleryTab } from '../components/react/TabbedGallery';
import FaqAccordion from '../components/react/FaqAccordion';
import ConsultationSection from '../components/react/ConsultationSection';
import { getFirstImageInDir, getImageAsset } from '../utils/images';

import {
  LANDSCAPING_ABOUT_DATA,
  LANDSCAPING_BEFORE_AFTER,
  LANDSCAPING_CONSULTATION_STEPS,
  LANDSCAPING_CONSULTATION_TOPICS,
  LANDSCAPING_CONTACT_CHANNELS,
  LANDSCAPING_CONTACTS,
  LANDSCAPING_FAQ_ITEMS,
  LANDSCAPING_MATERIALS_DATA,
  LANDSCAPING_OFFER,
  LANDSCAPING_PAGE_META,
  LANDSCAPING_REVIEWS,
  LANDSCAPING_SERVICES,
  LANDSCAPING_TRUST_REASONS,
  LANDSCAPING_WORK_CATEGORIES,
  type LandscapingWorkImageKey,
} from '../data/landscaping';

const beforeLandscapingImage = getImageAsset('landscaping/before-after/before');
const afterLandscapingImage = getImageAsset('landscaping/before-after/after');
const asphaltWorkImage = getImageAsset('landscaping/works/asphalt/asphalt');
const path1WorkImage = getImageAsset('landscaping/works/paths/path-1');
const path2WorkImage = getImageAsset('landscaping/works/paths/path-2');
const materialsSupplyImage =
  getImageAsset('landscaping/materials/объект-3', { useFallback: false }) ??
  getFirstImageInDir('landscaping/materials');

const WORK_IMAGE_ASSETS: Record<LandscapingWorkImageKey, ImageMetadata | null> = {
  after: afterLandscapingImage,
  asphalt: asphaltWorkImage,
  'path-1': path1WorkImage,
  'path-2': path2WorkImage,
  materials: materialsSupplyImage,
};

async function resolveOptimizedSrc(
  asset: ImageMetadata | null,
  quality: number,
): Promise<string> {
  if (!asset) {
    return '';
  }
  const optimized = await getImage({
    src: asset,
    width: 1280,
    format: 'webp',
    quality,
  });
  return optimized.src;
}

const [
  optimizedBeforeSrc,
  optimizedAfterSrc,
  optimizedAsphaltSrc,
  optimizedPath1Src,
  optimizedPath2Src,
  optimizedMaterialsSrc,
] = await Promise.all([
  resolveOptimizedSrc(beforeLandscapingImage, 86),
  resolveOptimizedSrc(afterLandscapingImage, 86),
  resolveOptimizedSrc(asphaltWorkImage, 84),
  resolveOptimizedSrc(path1WorkImage, 84),
  resolveOptimizedSrc(path2WorkImage, 84),
  resolveOptimizedSrc(materialsSupplyImage, 84),
]);

const OPTIMIZED_WORK_SRC: Record<LandscapingWorkImageKey, string> = {
  after: optimizedAfterSrc,
  asphalt: optimizedAsphaltSrc,
  'path-1': optimizedPath1Src,
  'path-2': optimizedPath2Src,
  materials: optimizedMaterialsSrc,
};

const workGalleryTabs: readonly GalleryTab[] = LANDSCAPING_WORK_CATEGORIES.map(
  (category) => ({
    id: category.id,
    number: category.number,
    label: category.label,
    slides: category.slides.map((slide) => ({
      id: slide.id,
      imageSrc: OPTIMIZED_WORK_SRC[slide.imageKey],
      imageAlt: slide.imageAlt,
      title: slide.title,
      location: slide.location,
      description: slide.description,
      specs: slide.specs,
    })),
  }),
);

const reviewGalleryTabs: readonly GalleryTab[] = [
  {
    id: 'client-reviews',
    number: '01',
    label: 'Проверенные отзывы клиентов · 8 объектов',
    slides: LANDSCAPING_REVIEWS.map((review) => ({
      id: review.id,
      imageSrc: OPTIMIZED_WORK_SRC[review.imageKey],
      imageAlt: review.imageAlt,
      title: review.author,
      author: review.author,
      location: review.location,
      service: review.service,
      date: review.date,
      source: review.source,
      rating: review.rating,
      description: review.quote,
      resultNote: review.resultNote,
    })),
  },
];

const landscapingFaqAsideSpecs = [
  { label: 'Замер', value: 'Выезд с нивелиром 0 ₽' },
  { label: 'Оплата', value: 'По факту этапов' },
  { label: 'Гарантия', value: 'До 5 лет по договору' },
] as const;

const landscapingConsultationContactInfo = {
  eyebrow: 'Прямая связь · Благоустройство',
  phoneDisplay: LANDSCAPING_CONTACTS.phoneDisplay,
  phoneHref: LANDSCAPING_CONTACTS.phoneHref,
  email: LANDSCAPING_CONTACTS.email,
  address: LANDSCAPING_CONTACTS.address,
  scheduleNote: LANDSCAPING_CONTACTS.scheduleNote,
  requisites: LANDSCAPING_CONTACTS.requisites,
  messengers: LANDSCAPING_CONTACTS.messengers,
} as const;
---

<Layout
  title={LANDSCAPING_PAGE_META.title}
  description={LANDSCAPING_PAGE_META.description}
  currentPath="/blagoustrojstvo"
>
  <!-- 01. HERO -->
  <Hero
    breadcrumbCurrent="Благоустройство участков"
    meta="Тюмень и область · Внешние работы"
    titlePrefix="Благоустройство участка, сделанное"
    titleAccent="на десятилетия."
    subtitle="Мощение брусчаткой, асфальтирование, отмостки и дренаж. Фиксируем смету до старта работ и даём гарантию до 5 лет."
    tags={[
      'асфальтирование',
      'брусчатка',
      'водоотведение',
      'отмостки',
      'тротуарная плитка',
    ]}
    ctaText="Заказать расчёт"
    imagePath="src/assets/images/landscaping/hero/"
    imageAlt="Благоустроенный загородный участок с мощением брусчаткой, отмосткой и дренажом в Тюмени"
    modalSource="landscaping-hero-cta"
  />

  <!-- 02. ПОЧЕМУ НАМ ДОВЕРЯЮТ (статичные карточки без hover-эффектов) -->
  <section
    id="why-us"
    class="scroll-mt-20 border-b border-border-subtle bg-bg-primary py-20 sm:py-28 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col justify-between gap-6 border-b border-border-subtle pb-10 lg:flex-row lg:items-end lg:pb-12">
        <div class="reveal max-w-2xl">
          <p class="mb-4 cursor-default text-xs uppercase tracking-[0.22em] text-text-muted">
            Подход к работе · 01 — 06
          </p>
          <h2 class="text-3xl font-normal leading-[1.12] tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
            Почему нам{' '}
            <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
              доверяют участки
            </span>
          </h2>
        </div>

        <p class="reveal reveal-delay-100 max-w-md text-sm leading-relaxed text-text-secondary sm:text-base">
          Строим основания с запасом прочности под сибирские морозы и весенний паводок, фиксируем
          условия в договоре и сдаём объект точно в срок.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-px border border-border-subtle bg-border-subtle md:grid-cols-2 lg:mt-14 lg:grid-cols-3">
        {LANDSCAPING_TRUST_REASONS.map((reason, index) => {
          const delayClass =
            index % 3 === 1
              ? 'reveal-delay-100'
              : index % 3 === 2
                ? 'reveal-delay-200'
                : '';

          return (
            <article class="flex h-full cursor-default flex-col justify-between bg-bg-secondary p-7 sm:p-8">
              <div class={`reveal ${delayClass} flex h-full flex-col justify-between`}>
                <div>
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-serif text-lg italic leading-none text-text-muted">
                      {reason.number}
                    </span>
                    <span class="cursor-default text-[11px] uppercase leading-none tracking-[0.18em] text-text-muted select-none">
                      {reason.category}
                    </span>
                  </div>

                  <h3 class="mt-6 text-xl font-normal leading-snug tracking-tight text-text-primary">
                    {reason.title}
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                    {reason.description}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 03. КАТАЛОГ УСЛУГ С ЦЕНАМИ (строго статичные карточки, запрещены hover-эффекты) -->
  <section
    id="services"
    class="scroll-mt-20 border-b border-border-subtle bg-bg-primary py-20 sm:py-28 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col justify-between gap-6 border-b border-border-subtle pb-10 lg:flex-row lg:items-end lg:pb-12">
        <div class="reveal max-w-2xl">
          <p class="mb-4 cursor-default text-xs uppercase tracking-[0.22em] text-text-muted">
            Каталог услуг и цены · 01 — 06
          </p>
          <h2 class="text-3xl font-normal leading-[1.12] tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
            Прозрачные расценки — от&nbsp;основания{' '}
            <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
              до&nbsp;финишного покрытия
            </span>
          </h2>
        </div>

        <p class="reveal reveal-delay-100 max-w-md text-sm leading-relaxed text-text-secondary sm:text-base">
          Итоговую стоимость рассчитываем после замера нивелиром с учётом типа грунта, площади и
          выбранного материала. Цены фиксируются в договоре.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-px border border-border-subtle bg-border-subtle md:grid-cols-2 lg:mt-14 lg:grid-cols-3">
        {LANDSCAPING_SERVICES.map((service, index) => {
          const delayClass =
            index % 3 === 1
              ? 'reveal-delay-100'
              : index % 3 === 2
                ? 'reveal-delay-200'
                : '';

          return (
            <article class="flex h-full cursor-default flex-col justify-between bg-bg-secondary p-7 sm:p-8">
              <div class={`reveal ${delayClass} flex h-full flex-col justify-between`}>
                <div>
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-serif text-lg italic leading-none text-text-muted">
                      {service.number}
                    </span>

                    {service.isFeatured ? (
                      <span class="inline-flex cursor-default items-center bg-accent-muted px-2.5 py-1 text-[11px] font-medium uppercase leading-none tracking-[0.16em] text-accent select-none">
                        {service.category}
                      </span>
                    ) : (
                      <span class="cursor-default text-[11px] uppercase leading-none tracking-[0.18em] text-text-muted select-none">
                        {service.category}
                      </span>
                    )}
                  </div>

                  <h3 class="mt-6 text-xl font-normal leading-snug tracking-tight text-text-primary">
                    {service.title}
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                    {service.description}
                  </p>

                  <ul class="mt-6 space-y-2.5 border-t border-border-subtle pt-5">
                    {service.deliverables.map((point) => (
                      <li class="flex items-start gap-2.5 text-xs leading-relaxed text-text-secondary">
                        <span
                          class="mt-2 h-px w-3 shrink-0 bg-text-muted"
                          aria-hidden="true"
                        ></span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-8 flex items-baseline justify-between gap-4 border-t border-border-subtle pt-5">
                  <span class="text-base font-medium text-text-primary">
                    {service.priceLabel}
                  </span>
                  <span class="text-xs text-text-muted">
                    {service.timelineLabel}
                  </span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 04. ИНТЕРАКТИВНЫЙ БЛОК «ДО / ПОСЛЕ» (React client:visible) -->
  <section
    id="before-after"
    class="scroll-mt-20 border-b border-border-subtle bg-bg-primary py-20 sm:py-28 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="reveal lg:col-span-5">
          <span class="inline-flex cursor-default items-center bg-accent-muted px-3 py-1.5 text-[11px] font-medium uppercase leading-none tracking-[0.18em] text-accent select-none">
            {LANDSCAPING_BEFORE_AFTER.badge}
          </span>

          <h2 class="mt-5 text-3xl font-normal leading-[1.14] tracking-tight text-text-primary sm:text-4xl">
            {LANDSCAPING_BEFORE_AFTER.titlePrefix}
            <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
              {LANDSCAPING_BEFORE_AFTER.titleAccent}
            </span>
          </h2>

          <p class="mt-4 text-sm leading-relaxed text-text-secondary sm:text-base">
            {LANDSCAPING_BEFORE_AFTER.editorialNote}
          </p>

          <dl class="mt-6 grid grid-cols-2 gap-px border border-border-subtle bg-border-subtle">
            <div class="cursor-default bg-bg-secondary px-4 py-3">
              <dt class="text-[11px] uppercase tracking-[0.16em] text-text-muted">
                Площадь
              </dt>
              <dd class="mt-1 text-sm font-medium text-text-primary">
                {LANDSCAPING_BEFORE_AFTER.specs.area}
              </dd>
            </div>
            <div class="cursor-default bg-bg-secondary px-4 py-3">
              <dt class="text-[11px] uppercase tracking-[0.16em] text-text-muted">
                Срок работ
              </dt>
              <dd class="mt-1 text-sm font-medium text-text-primary">
                {LANDSCAPING_BEFORE_AFTER.specs.timeline}
              </dd>
            </div>
            <div class="cursor-default bg-bg-secondary px-4 py-3">
              <dt class="text-[11px] uppercase tracking-[0.16em] text-text-muted">
                Локация
              </dt>
              <dd class="mt-1 text-sm font-medium text-text-primary">
                {LANDSCAPING_BEFORE_AFTER.specs.location}
              </dd>
            </div>
            <div class="cursor-default bg-bg-secondary px-4 py-3">
              <dt class="text-[11px] uppercase tracking-[0.16em] text-text-muted">
                Гарантия
              </dt>
              <dd class="mt-1 text-sm font-medium text-text-primary">
                {LANDSCAPING_BEFORE_AFTER.specs.warranty}
              </dd>
            </div>
          </dl>

          <div class="mt-7">
            <button
              type="button"
              data-lead-trigger="landscaping-before-after"
              data-lead-complex={LANDSCAPING_BEFORE_AFTER.projectComplex}
              data-lead-title={`${LANDSCAPING_BEFORE_AFTER.titlePrefix}${LANDSCAPING_BEFORE_AFTER.titleAccent}`}
              data-lead-area={LANDSCAPING_BEFORE_AFTER.specs.area}
              class="inline-flex cursor-pointer items-center justify-center gap-2.5 rounded-sm bg-accent px-6 py-3.5 text-sm font-medium text-text-primary transition-colors duration-[350ms] ease-[var(--ease-editorial)] hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
            >
              <span>{LANDSCAPING_BEFORE_AFTER.ctaLabel}</span>
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </button>
          </div>
        </div>

        <div class="reveal reveal-delay-100 lg:col-span-7">
          <BeforeAfterSlider
            client:visible
            beforeSrc={optimizedBeforeSrc}
            afterSrc={optimizedAfterSrc}
            beforeAlt={LANDSCAPING_BEFORE_AFTER.beforeAlt}
            afterAlt={LANDSCAPING_BEFORE_AFTER.afterAlt}
            beforeLabel={LANDSCAPING_BEFORE_AFTER.beforeLabel}
            afterLabel={LANDSCAPING_BEFORE_AFTER.afterLabel}
            initialPosition={50}
            ariaLabel="Сравнение участка до и после благоустройства"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 05. ГАЛЕРЕЯ РАБОТ ПО КАТЕГОРИЯМ (TabbedGallery.tsx client:visible) -->
  <section
    id="works"
    class="scroll-mt-20 border-b border-border-subtle bg-bg-primary py-20 sm:py-28 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col justify-between gap-6 border-b border-border-subtle pb-10 lg:flex-row lg:items-end lg:pb-12">
        <div class="reveal max-w-2xl">
          <p class="mb-4 cursor-default text-xs uppercase tracking-[0.22em] text-text-muted">
            Выполненные объекты · 01 — 04
          </p>
          <h2 class="text-3xl font-normal leading-[1.12] tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
            Галерея работ{' '}
            <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
              по&nbsp;категориям
            </span>
          </h2>
        </div>

        <p class="reveal reveal-delay-100 max-w-md text-sm leading-relaxed text-text-secondary sm:text-base">
          Переключайте направления, чтобы посмотреть детали мощения, примыканий, бордюров и
          асфальтовых покрытий на реальных объектах в Тюмени и области.
        </p>
      </div>

      <div class="mt-12 lg:mt-14">
        <TabbedGallery
          client:visible
          tabs={workGalleryTabs}
          variant="works"
          ariaLabel="Галерея выполненных работ по благоустройству"
          ctaLabel="Рассчитать похожий объект"
          leadSource="landscaping-gallery"
        />
      </div>
    </div>
  </section>

  <!-- 06. ПРЯМЫЕ ПОСТАВКИ МАТЕРИАЛОВ + АКЦЕНТНАЯ ПЛАШКА «ВЫЕЗД И СКИДКА 5%» -->
  <section
    id="materials"
    class="scroll-mt-20 border-b border-border-subtle bg-bg-primary py-20 sm:py-28 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
        <div class="reveal lg:col-span-6">
          <div class="relative aspect-[4/3] overflow-hidden border border-border-subtle bg-bg-secondary">
            <SafeImage
              src={WORK_IMAGE_ASSETS.materials}
              alt={LANDSCAPING_MATERIALS_DATA.imageAlt}
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center"
            />
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-bg-primary/75 via-bg-primary/20 to-transparent"
            ></div>
            <span class="pointer-events-none absolute bottom-4 left-4 inline-flex cursor-default items-center border border-border-subtle bg-bg-primary/85 px-3 py-1.5 text-[11px] uppercase leading-none tracking-[0.16em] text-text-secondary backdrop-blur-sm select-none">
              Заводские паспорта качества
            </span>
          </div>
        </div>

        <div class="reveal reveal-delay-100 lg:col-span-6">
          <p class="mb-4 cursor-default text-xs uppercase tracking-[0.22em] text-text-muted">
            {LANDSCAPING_MATERIALS_DATA.eyebrow}
          </p>

          <h2 class="text-3xl font-normal leading-[1.12] tracking-tight text-text-primary sm:text-4xl">
            {LANDSCAPING_MATERIALS_DATA.titlePrefix}
            <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
              {LANDSCAPING_MATERIALS_DATA.titleAccent}
            </span>
          </h2>

          <p class="mt-4 text-sm leading-relaxed text-text-secondary sm:text-base">
            {LANDSCAPING_MATERIALS_DATA.description}
          </p>

          <!-- Статичный список фактов снабжения: строго без hover -->
          <div class="mt-8 divide-y divide-border-subtle border-y border-border-subtle">
            {LANDSCAPING_MATERIALS_DATA.facts.map((fact) => (
              <div class="flex cursor-default items-start gap-4 py-5">
                <span
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 font-serif text-base italic leading-none text-accent"
                >
                  {fact.number}
                </span>
                <div>
                  <h3 class="text-base font-medium leading-snug text-text-primary">
                    {fact.title}
                  </h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-text-secondary sm:text-sm">
                    {fact.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Спокойная акцентная плашка со скидкой 5%: плашка строго статична, кликабельна только кнопка -->
      <aside
        id="offer"
        aria-labelledby="landscaping-offer-title"
        class="reveal mt-16 cursor-default border border-border-accent bg-bg-elevated p-7 sm:p-10 lg:mt-20 lg:p-12"
      >
        <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-center lg:gap-12">
          <div class="max-w-2xl">
            <span class="inline-flex cursor-default items-center bg-accent-muted px-3 py-1.5 text-[11px] font-medium uppercase leading-none tracking-[0.18em] text-accent select-none">
              {LANDSCAPING_OFFER.badge}
            </span>

            <h3
              id="landscaping-offer-title"
              class="mt-5 text-2xl font-normal leading-[1.18] tracking-tight text-text-primary sm:text-3xl"
            >
              {LANDSCAPING_OFFER.titlePrefix}
              <span class="font-serif text-[1.12em] font-medium italic text-text-primary">
                {LANDSCAPING_OFFER.titleAccent}
              </span>
            </h3>

            <p class="mt-3.5 text-sm leading-relaxed text-text-secondary sm:text-base">
              {LANDSCAPING_OFFER.description}
            </p>

            <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-xs text-text-muted">
              {LANDSCAPING_OFFER.highlights.map((item) => (
                <li class="inline-flex cursor-default items-center gap-2">
