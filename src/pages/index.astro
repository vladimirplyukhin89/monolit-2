---
import Layout from '../layouts/Layout.astro';
import SafeImage from '../components/astro/SafeImage.astro';
import { HUB_CONFIG } from '../data/navigation';
import { getImageAsset } from '../utils/images';

const resolvedCards = HUB_CONFIG.cards.map((card) => ({
  ...card,
  image: getImageAsset(card.imagePath),
}));
---

<Layout
  title={HUB_CONFIG.title}
  description={HUB_CONFIG.description}
  currentPath="/"
  compact={true}
>
  <section
    aria-label="Выбор направления компании МОНОЛИТ"
    class="relative flex flex-1 flex-col bg-bg-primary"
  >
    <h1 class="sr-only">МОНОЛИТ — выбор направления работ в Тюмени</h1>

    <div class="grid flex-1 grid-cols-1 divide-y divide-border-subtle lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      {resolvedCards.map((card, index) => (
        <a
          href={card.href}
          class="hub-card group relative flex min-h-[max(420px,52svh)] shrink-0 flex-col justify-between overflow-hidden bg-bg-secondary p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent sm:min-h-[max(460px,52svh)] sm:p-10 lg:min-h-0 lg:p-12 xl:p-16"
        >
          <!-- Фоновая фотография с плавным CSS-зумом (scale 1.03 за 1000ms) -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-0 overflow-hidden select-none"
          >
            <SafeImage
              src={card.image}
              alt={card.imageAlt}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="eager"
              fetchpriority={index === 0 ? 'high' : 'auto'}
              class="editorial-bg-image hub-card-image h-full w-full object-cover object-center opacity-70"
            />
            <!-- Тёмная тема: плотное затемнение кадра -->
            <div class="editorial-bg-scrim-dark absolute inset-0 bg-gradient-to-t from-[#09090B]/90 via-[#09090B]/55 to-[#09090B]/20 transition-opacity duration-[700ms] ease-[var(--ease-editorial)] group-hover:opacity-90" />
            <div class="editorial-bg-scrim-dark absolute inset-0 bg-gradient-to-b from-[#09090B]/55 via-transparent to-transparent" />
            <!-- Светлая тема: только нижний градиент под белым текстом, верх кадра открыт -->
            <div class="editorial-bg-scrim-light absolute inset-0 bg-gradient-to-t from-[#09090B]/85 via-[#09090B]/35 to-transparent" />
          </div>

          <!-- Деликатная верхняя акцентная линия при наведении на кликабельную карточку -->
          <span
            aria-hidden="true"
            class="hub-card-line pointer-events-none absolute inset-x-0 top-0 z-10 h-px bg-accent opacity-0 transition-opacity duration-[400ms] ease-[var(--ease-editorial)] group-hover:opacity-100 group-focus-visible:opacity-100"
          />

          <!-- Верхняя строка карточки: мета-тег направления -->
          <div class="relative z-10 flex items-center justify-between gap-4">
            <span class="inline-flex items-center gap-2.5 text-xs uppercase tracking-[0.22em] text-white/85 transition-colors duration-300 group-hover:text-white">
              <span
                aria-hidden="true"
                class="h-1.5 w-1.5 rounded-full bg-accent"
              />
              <span>{card.eyebrow}</span>
            </span>

            <span
              aria-hidden="true"
              class="inline-flex h-9 w-9 items-center justify-center rounded-sm border border-white/25 bg-[#09090B]/65 text-white/85 backdrop-blur-sm transition-colors duration-300 group-hover:border-border-accent group-hover:text-accent group-focus-visible:border-border-accent group-focus-visible:text-accent"
            >
              <svg
                class="h-4 w-4 transition-transform duration-[400ms] ease-[var(--ease-editorial)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transform-none"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17 17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </span>
          </div>

          <!-- Нижняя редакционная группа: заголовок, подзаголовок и CTA-действие -->
          <div class="relative z-10 mt-16 max-w-xl sm:mt-20 lg:mt-auto">
            <h2 class="text-3xl font-normal leading-[1.1] tracking-tight text-white sm:text-4xl lg:text-[2.65rem] xl:text-5xl">
              {card.titlePrefix}
              <span class="font-serif text-[1.15em] font-medium italic leading-none text-accent md:text-[1.12em] md:leading-[1.15]">
                {card.titleAccent}
              </span>
            </h2>

            <p class="mt-4 max-w-md text-sm leading-relaxed text-white/85 sm:text-base">
              {card.subtitle}
            </p>

            <ul class="mt-5 max-w-md space-y-2">
              {card.works.map((work) => (
                <li class="flex items-start gap-2.5 text-sm leading-snug text-white">
                  <span
                    aria-hidden="true"
                    class="mt-[0.45em] h-1 w-1 shrink-0 bg-accent"
                  />
                  <span>{work}</span>
                </li>
              ))}
            </ul>

            <div class="mt-7 inline-flex items-center gap-3 border-b border-white/30 pb-2 text-sm font-medium text-white transition-colors duration-300 group-hover:border-accent group-hover:text-accent group-focus-visible:border-accent group-focus-visible:text-accent">
              <span>{card.actionLabel}</span>
              <span
                aria-hidden="true"
                class="inline-block transition-transform duration-[400ms] ease-[var(--ease-editorial)] group-hover:translate-x-1.5 group-focus-visible:translate-x-1.5 motion-reduce:transform-none"
              >
                &rarr;
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
